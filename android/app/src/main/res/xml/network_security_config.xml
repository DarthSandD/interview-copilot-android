<?xml version="1.0" encoding="utf-8"?>
<!--
  Only the Hugging Face host is reachable, and only over TLS. Everything the
  app does after the one-time model download is offline, so this config
  denies cleartext everywhere by default.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
